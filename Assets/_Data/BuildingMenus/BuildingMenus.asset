  tractorImage: {fileID: 0}
  tractorName:
    russian: "\u041A\u0443\u0440\u043E\u043C\u043E\u0431\u0438\u043B\u044C-3000"
    english: Chickenmobile 3000
    german: "H\xFChnermobil 3000"
  tractorDescription:
    russian: "\u0421\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439 \u0442\u0440\u0430\u043A\u0442\u043E\u0440\n\u0414\u043E\u0441\u0442\u0443\u043F\u0435\u043D
      \u0441 \u043D\u0430\u0447\u0430\u043B\u0430 \u0438\u0433\u0440\u044B"
    english: 'Starter tractor

      Available from the start'
    german: "Starttraktor\nVon Anfang an verf\xFCgbar"
  alienStoryImage: {fileID: 2800000, guid: 7d9755fd451a42ca826fd02123c3ee16, type: 3}
  alienStory:
    russian: "\u0412 \u0442\u0443 \u043D\u043E\u0447\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435
      \u043F\u043E\u0433\u0430\u0441\u043B\u0438 \u0432\u0441\u0435 \u0444\u043E\u043D\u0430\u0440\u0438.
      \u041D\u0430\u0434 \u043F\u043E\u043B\u0435\u043C \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0441\u0432\u0435\u0442, \u0430
      \u0438\u0437 \u043A\u0443\u0440\u044F\u0442\u043D\u0438\u043A\u0430 \u0434\u043E\u043D\u0451\u0441\u0441\u044F
      \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0439
      \u043F\u0438\u0441\u043A.\n\n\u0417\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438
      \u0434\u0432\u0435\u0440\u044F\u043C\u0438 \u0443\u0436\u0435 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u043B\u0438
      \u0441\u0442\u0440\u0430\u043D\u043D\u0443\u044E \u0433\u043E\u0441\u0442\u044C\u044E:
      \u043A\u0443\u0440\u0438\u0446\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u044F\u0432\u043D\u043E \u043F\u0440\u0438\u0431\u044B\u043B\u0430 \u043D\u0435
      \u0441 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439 \u0444\u0435\u0440\u043C\u044B.\n\n\u041D\u0430\u0439\u0434\u0438
      \u0438\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u0443\u044E \u043A\u0443\u0440\u0438\u0446\u0443
      \u0438 \u0443\u0437\u043D\u0430\u0439, \u0437\u0430\u0447\u0435\u043C \u043E\u043D\u0430
      \u0437\u0434\u0435\u0441\u044C. \u041D\u043E \u0431\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D:
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0437\u0430 \u043D\u0435\u0439
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0448\u044C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u044B\u2026"
    english: "That night, every light on the farm went out. A green glow appeared
      over the field, and a very unusual chirp came from the coop.\n\nBehind closed
      doors, a strange visitor was already being discussed: a chicken that clearly
      had not come from the neighbouring farm.\n\nFind the alien chicken and discover
      why she is here. Be careful: you may not be the only one watching her\u2026"
    german: "In jener Nacht gingen alle Lichter auf dem Hof aus. \xDCber dem Feld
      erschien ein gr\xFCner Schein, und aus dem H\xFChnerstall kam ein ungew\xF6hnliches
      Piepsen.\n\nHinter verschlossenen T\xFCren sprach man bereits \xFCber den seltsamen
      Gast: ein Huhn, das ganz sicher nicht vom Nachbarhof kam.\n\nFinde das Alien-Huhn
      und entdecke, warum es hier ist. Sei vorsichtig: Offenbar beobachtest nicht
      nur du es\u2026"
  alienMusicEvent: event:/Menu_Inner
  backgroundMusicEvent: event:/Menu&Base_Music
