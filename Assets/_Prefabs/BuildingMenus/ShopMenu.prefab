  m_text: "\u0412 \u0442\u0443 \u043D\u043E\u0447\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435
    \u043F\u043E\u0433\u0430\u0441\u043B\u0438 \u0432\u0441\u0435 \u0444\u043E\u043D\u0430\u0440\u0438.
    \u041D\u0430\u0434 \u043F\u043E\u043B\u0435\u043C \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
    \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0441\u0432\u0435\u0442, \u0430 \u0438\u0437
    \u043A\u0443\u0440\u044F\u0442\u043D\u0438\u043A\u0430 \u0434\u043E\u043D\u0451\u0441\u0441\u044F
    \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0439
    \u043F\u0438\u0441\u043A.\n\n\u0417\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438
    \u0434\u0432\u0435\u0440\u044F\u043C\u0438 \u0443\u0436\u0435 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u043B\u0438
    \u0441\u0442\u0440\u0430\u043D\u043D\u0443\u044E \u0433\u043E\u0441\u0442\u044C\u044E:
    \u043A\u0443\u0440\u0438\u0446\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u044F\u0432\u043D\u043E \u043F\u0440\u0438\u0431\u044B\u043B\u0430 \u043D\u0435
    \u0441 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439 \u0444\u0435\u0440\u043C\u044B.\n\n\u041D\u0430\u0439\u0434\u0438
    \u0438\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u0443\u044E \u043A\u0443\u0440\u0438\u0446\u0443
    \u0438 \u0443\u0437\u043D\u0430\u0439, \u0437\u0430\u0447\u0435\u043C \u043E\u043D\u0430
    \u0437\u0434\u0435\u0441\u044C. \u041D\u043E \u0431\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D:
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0437\u0430 \u043D\u0435\u0439 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0448\u044C
